# Agency OS — example environment. Copy to .env (git-ignored) or export these directly.
# NOTHING here is a real credential.

# A fine-grained GitHub PAT with "Contents: read and write" on the agency repositories.
# Placeholder only: the "11EXAMPLE0…" body is not a credential. Never commit the real value,
# and never paste a real token into a document or a chat either.
export GITHUB_PAT="github_pat_11EXAMPLE0AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# Identity used when the deck acts on the board in write mode.
export AGENCY_OS_AGENT="your-agent-name"
export AGENCY_OS_OPERATOR="carlo"

# Where the deck listens. 0.0.0.0 is required in hosted sandboxes that proxy ports.
export AGENCY_OS_HOST="0.0.0.0"
export AGENCY_OS_PORT="8787"

# Optional: point at existing checkouts instead of cloning mirrors.
# export AGENCY_OS_CHATCODE_DIR="$HOME/work/chatcode"
# export AGENCY_OS_AGENCY_DIR="$HOME/work/agency"
# export AGENCY_OS_STORAGECODE_DIR="$HOME/work/storagecode"

# Seconds between ff-only pulls of the mirrors (0 disables background sync).
export AGENCY_OS_SYNC_INTERVAL="180"

# Arm write mode (also requires GITHUB_PAT and an agent identity).
# export AGENCY_OS_ALLOW_ACTIONS="1"
