venv/
.pytest_cache/
.mypy_cache/

# node (only ever used for syntax checks)
node_modules/
package-lock.json

# editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# local measurement artefacts
/tmp/
*.png.tmp
